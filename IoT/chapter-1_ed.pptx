// C++ code//int pin_red =2;int pin_yellow = 3;int pin_green=4;void setup(){  pinMode(pin_red, OUTPUT);  pinMode(pin_yellow,OUTPUT);  pinMode(pin_green,OUTPUT);}void loop(){  digitalWrite(pin_red, HIGH);  delay(3000);  digitalWrite(pin_red, LOW);        //Yellow    digitalWrite(pin_yellow, HIGH);  delay(700);   digitalWrite(pin_yellow, LOW);  delay(700);  digitalWrite(pin_yellow, HIGH);  delay(700);  digitalWrite(pin_yellow, LOW);  delay(700);  digitalWrite(pin_yellow, LOW);  delay(700);    //green  digitalWrite(pin_green,HIGH);  delay(5000);  digitalWrite(pin_green,LOW);}